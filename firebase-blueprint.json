{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and department.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Director", "Manager", "Staff"] },
        "department": { "type": "string", "enum": ["Finance", "HR", "GA", "All"] }
      },
      "required": ["email", "name", "role", "department"]
    },
    "Task": {
      "title": "Task",
      "description": "A task assigned to a staff in a department.",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "department": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "On Progress", "Closed"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["staffId", "staffName", "department", "description", "startDate", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Log of actions performed on tasks.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["taskId", "action", "timestamp", "userId", "userName"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with their access role."
    },
    "tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "The main tasks collection."
    },
    "logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit trails for tasks."
    }
  }
}
