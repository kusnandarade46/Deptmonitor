rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : null;
    }

    function isDirector() {
      return getRole() == 'Director';
    }

    function isManager() {
      return getRole() == 'Manager';
    }

    function isStaff() {
      return getRole() == 'Staff';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'department'])
        && data.role in ['Director', 'Manager', 'Staff']
        && data.department in ['Finance', 'HR', 'GA', 'All'];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    function isValidTask(data) {
      return data.keys().hasAll(['staffName', 'department', 'description', 'startDate', 'dueDate', 'status'])
        && data.staffName is string 
        && data.department is string 
        && data.description is string 
        && data.status in ['Open', 'On Progress', 'Closed'];
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
